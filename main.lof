\contentsline {figure}{\numberline {4.1}{\ignorespaces Projected O5 strain sensitivity curves}}{84}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Optimal SNR for L1 ($\rho _\mathrm {opt}^{\mathrm {L1}}$, light orange), H1 ($\rho _\mathrm {opt}^{\mathrm {H1}}$, orange), and the network ($\rho _\mathrm {opt}^{\mathrm {net}}$, brown), for the full detectable population ($N=500$, dashed) and the final injection set ($N=157$, solid).}}{87}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Left: primary source-frame mass $m_1^{\mathrm {src}}$. Right: number of lensed images per event, comparing the true image multiplicity ($N=500$, dashed) against the number surviving the duty cycle and SNR filters before the top-2 cut ($N=157$, solid).}}{87}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces \textit {Left}: true luminosity distance $d_L$ (brown) versus effective luminosity distance $d_L^{\mathrm {eff}}$ (orange). \textit {Right}: image magnification $\mu $.}}{88}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Source-frame component masses $m_1^{\mathrm {src}}$ and $m_2^{\mathrm {src}}$ for the 500 detectable lensed BBH events selected by \textsc {LeR}, colour-coded by network SNR $\rho _\mathrm {net}$. Diagonal dashed lines mark constant total mass $M$ and dotted lines mark constant mass ratio $q$. The population traces the underlying LIGO O3 Power Law + Gaussian model (\S \ref {sec:LER_population}), with most events clustering near $q=1$ and the highest-SNR events concentrated around $M\sim 50$-$70\,M_\odot $.}}{88}{figure.4.5}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Distribution of time delays $\Delta t$ between the two lensed images for the 500 detectable lensed BBH events, shown on a logarithmic scale. The distribution spans from minutes to months, consistent with galaxy-scale lenses in the geometric optics regime. The Earth's rotation during this interval is the primary mechanism enabling improved sky localization through joint analysis (\S \ref {sec:joint_PE_skyloc}).}}{89}{figure.4.6}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Overview of the full analysis pipeline developed in this thesis. Stage~1 (\S \ref {sec:LER_population}-\S \ref {sec:injected_params}): the lensed BBH population is generated with \textsc {LeR} and reduced from 500 detectable events to the final injection set of 157 through the duty cycle and SNR selection process (Table~\ref {tab:selection_funnel}). Stage~2 (\S \ref {sec:automation_picasso}): \texttt {Generator\_inis\_lenskyloc.py} converts each event's injected parameters into single-image and joint \texttt {.ini} configurations and the corresponding SLURM scripts. Stage~3 (\S \ref {sec:bilby_config}-\S \ref {sec:hanabi_joint}): each image is analyzed independently with \textsc {Bilby}, then jointly with \textsc {Hanabi}, sharing the intrinsic source parameters and sky location while keeping each image's luminosity distance independent. Stage~4 (\S \ref {sec:skymap_generation}-\S \ref {sec:skyloc_comparison}): sky maps are generated from the posteriors and the recovered 90\% credible areas are compared between single-image and joint analyses.}}{90}{figure.5.1}%
