\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Representation of the three main types of geometry: Euclidean (flat), spherical (positive curvature), and hyperbolic (negative curvature). In each case, the sum of the angles of a triangle differs: it equals 180\textdegree {} in Euclidean geometry, exceeds 180\textdegree {} in spherical geometry, and is less than 180\textdegree {} in hyperbolic geometry. Source: \blx@tocontentsinit {0}\cite {Imatgenoneuclidean}.}}{5}{figure.1.1}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces The set of all vectors defined at a point \(p\) forms the tangent space \(T_p(\mathcal {M})\) at \(p\). Assembling the tangent spaces for every point of the manifold produces the tangent bundle \(T(\mathcal {M})\). Original illustration based on the source: \blx@tocontentsinit {0}\cite {tangentspaceimage}.}}{6}{figure.1.2}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Representation of a chart $(U, \varphi )$ on a manifold $\mathcal {M}$, where the subset $U \subset \mathcal {M}$ is mapped bijectively to an open set $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle U$}\mathaccent "0365{U} \subset \mathbb {R}^n$ via $\varphi $. Source: \blx@tocontentsinit {0}\cite {Coordinatebasis}.}}{7}{figure.1.3}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces When two charts overlap, their coordinate systems are related by a smooth transition map. Original illustration based on the source: \blx@tocontentsinit {0}\cite {Coordinatebasis}.}}{7}{figure.1.4}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Comparison between parallel transport in flat and curved spaces. In flat space, the vector returns unchanged after a closed loop; in curved space, the final result depends on the path taken, revealing the manifold's intrinsic geometry. Original illustrations based on the sources: \blx@tocontentsinit {0}\cite {Llibre_Peter_Collier_unacosadificildecomprender, ParallelTransportSvg}.}}{16}{figure.1.5}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Illustration of parallel transport around an infinitesimal closed loop, showing the deviation of a vector due to curvature, characterized by the Riemann tensor $R^{\lambda }_{\ \mu \nu \rho }$. In the presence of torsion, described by the torsion tensor $T^{\rho }{}_{\mu \nu }$, the infinitesimal parallelogram fails to close, providing a geometric measure of the antisymmetric part of the connection. Source: \blx@tocontentsinit {0}\cite {LlibreBertJanssen}.}}{19}{figure.1.6}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Schematic representation of the energy-momentum tensor $T_{\mu \nu }$ as a $4 \times 4$ matrix. Source: \blx@tocontentsinit {0}\cite {energymomentumtensor}.}}{23}{figure.1.7}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Light cones in the $t$-$r$ plane of Schwarzschild spacetime. Far from the BH, cones open symmetrically at $\pm 45^\circ $. As $r \to 2GM$ they progressively close; inside the horizon they invert, pointing inexorably toward $r=0$. Original illustrations based on: \blx@tocontentsinit {0}\cite {LlibreBertJanssen, llibrecarroll2004lectures}.}}{27}{figure.1.8}%
\contentsline {figure}{\numberline {1.9}{\ignorespaces In Eddington-Finkelstein coordinates the horizon is regular. Ingoing geodesics always remain at $45^\circ $; outgoing ones tilt progressively inward until at $r=2GM$ they are trapped, and for $r < 2GM$ all light falls toward the singularity. Original illustrations based on: \blx@tocontentsinit {0}\cite {LlibreBertJanssen, Llibre_Peter_Collier_unacosadificildecomprender}.}}{28}{figure.1.9}%
\contentsline {figure}{\numberline {1.10}{\ignorespaces (a) Simplified depiction of a BH. The event horizon (red line) marks the boundary beyond which nothing can escape. Inside, all paths lead to the singularity (blue dot). (b) More detailed diagram showing the causal structure of a Schwarzschild BH. The light cones tip inward as one approaches the horizon, and inside they point entirely toward the singularity, indicating that all causal trajectories inevitably end there. Source: \blx@tocontentsinit {0}\cite {nobel2020blackholes}. }}{29}{figure.1.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces A monochromatic GW with angular frequency $\omega = 2\pi /T$ propagates in the $\hat {z}$ direction. The lower panel illustrates the deformation produced by the $+$ and $\times $ polarization modes on a ring of freely falling test particles in a local inertial frame. Source: \blx@tocontentsinit {0}\cite {Theory_of_Gravitational_Waves_arxiv}.}}{41}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Spatial regions associated with a compact binary source of GWs. The strong-field region, weak-field near zone, and the local and distant wave zones are indicated, separated by the characteristic scales $r_I$ and $r_O$. GW generation predominantly occurs in the near zone (green arrow), while wave propagation is described in the distant wave zone (red arrow). Original illustration based on the sources: \blx@tocontentsinit {0}\cite {zonesofinfluence, thorne2009lorentz}.}}{41}{figure.2.2}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Representation of the past light cone of the observation event $(ct,\mathbf {x})$. GWs propagate at the finite speed $c$, so the metric perturbation measured at the detector is determined by the configuration of the source at the retarded time $t' = t - |\mathbf {x}-\mathbf {y}|/c$. Only the portion of the source worldtube intersecting the past light cone contributes to the observed gravitational field, ensuring causal propagation. Source: \blx@tocontentsinit {0}\cite {Theory_of_Gravitational_Waves_arxiv}.}}{42}{figure.2.3}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Classification of GW sources according to their temporal character (transient vs.\ persistent) and the availability of accurate waveform models (modelled vs.\ unmodelled), encompassing CBCs, burst events, continuous waves, and the stochastic background. Credit: Shanika Galaudage (@astronerdika).}}{45}{figure.2.4}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces The three phases of a CBC: the inspiral, during which the two compact objects lose energy through GW emission and progressively approach each other; the merger, when the objects collide and coalesce; and the ringdown, in which the remnant settles into a stationary configuration by radiating the remaining perturbations. The corresponding gravitational waveform, showing the characteristic chirp of increasing frequency and amplitude, is displayed beneath each phase. Credit: Illustration by Lucy Reading-Ikkanda.}}{45}{figure.2.5}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Optical layout of the advanced LIGO interferometer, illustrating the Fabry-Pérot arm cavities, the power recycling mirror (PRM) at the input port, and the signal recycling mirror (SRM) at the output port. Source: \blx@tocontentsinit {0}\cite {Layout_LIGO}.}}{48}{figure.2.6}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Geometric relationship between the detector frame $(\bar {x},\bar {y},\bar {z})$ and the wave frame $(x',y',z')$. The interferometer arms lie in the $(\bar {x},\bar {y})$ plane, with $\bar {z}$ pointing toward the local zenith. The angles $\bar {\theta }_N$ and $\bar {\phi }_N$ give the polar and azimuthal coordinates of the incoming wave direction in the detector frame, and $\psi $ denotes the rotation of the polarization axes about the propagation direction. Own production based on the source: \blx@tocontentsinit {0}\cite {ABADIE2010223}.}}{49}{figure.2.7}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Polarization-averaged antenna pattern $|F|$ of a ground-based interferometer with orthogonal arms ($\zeta =\pi /2$), as a function of sky angles $(\bar {\theta }_N,\bar {\phi }_N)$. Original result.}}{51}{figure.2.8}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Antenna patterns for the plus ($F_+$, top) and cross ($F_\times $, bottom) polarizations for $\zeta =\pi /2$ and representative values of $\psi $. Original result.}}{52}{figure.2.9}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces High-resolution amplitude spectral density ($\Delta f = 1/1800$\,Hz) of LIGO Hanford strain data illustrating three representative line artefacts. \textit {Left:} a broad spectral feature associated with mirror suspension roll-mode resonances. \textit {Centre:} an isolated narrow line of unknown origin. \textit {Right:} two frequency combs with distinct spacings, marked by upright and inverted triangles, alongside broader noise structures. Source: \blx@tocontentsinit {0}\cite {glitches_lines_noises}.}}{53}{figure.2.10}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Time-frequency spectrograms of representative glitch classes recorded at LHO and LLO. Slow and Fast Scattering artefacts are attributed to light scattered by optics under increased ground motion, while the origin of Extremely Loud, Tomte, Low Frequency Burst, and Low Frequency Lines glitches remains unidentified. Source: \blx@tocontentsinit {0}\cite {glitches_lines_noises}.}}{54}{figure.2.11}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Strain noise amplitude spectral density of the LLO detector during O4, together with the O3 LLO and O4 LHO curves for comparison. Dashed lines indicate noise contributions estimated from analytical models or independent component measurements; dotted lines correspond to noise projected from auxiliary witness channels. The black curve gives the quadrature sum of all known noise sources. Three regimes are apparent: control noise dominates below $\sim \!50$\,Hz, a combination of quantum and thermal noise governs the intermediate band, and shot noise sets the high-frequency floor above $\sim \!500$\,Hz. Narrow spectral lines from power-line harmonics, violin modes, and calibration injections are visible throughout the spectrum. Source: \blx@tocontentsinit {0}\cite {noise_budget_O4}.}}{55}{figure.2.12}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Aerial and underground views of the current LVK detector network. Top row, left to right: LIGO Hanford (Washington, USA), LIGO Livingston (Louisiana, USA), and Advanced Virgo (Cascina, Italy). Bottom row, left to right: KAGRA underground tunnel (Kamioka, Japan) and GEO600 (Hannover, Germany). Sources: \blx@tocontentsinit {0}\cite {HANFORD, LIGO_Livingston_image, eoportal_virgo,asiop_kagra,geo600_website}.}}{56}{figure.2.13}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Timeline of LVK observing runs from the first detection in 2015 through the start of O4c in January 2025. Colored bars indicate the periods during which each detector was operating, together with the typical BNS inspiral range achieved in each run. GEO\,600 astrowatch and KAGRA O4a periods (light gray) were not included in the main GW analyses. In O1 and O4a only LHO and LLO participated; Virgo joined for the final month of O2 and operated throughout O3a, O3b and O4b. A short joint O3GK run also included GEO\,600 and KAGRA. Tick marks along the top indicate GW candidates from GWTC-1 through GWTC-5 with astrophysical probability $\geq 50\%$. Source: \blx@tocontentsinit {0}\cite {GWTC5}.}}{56}{figure.2.14}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Schematic comparison of the two main stochastic sampling strategies. MCMC draws samples directly from the posterior via a random walk, combining them to reconstruct the distribution. Nested sampling instead decomposes the posterior into nested likelihood slices, samples from each slice independently, and combines the weighted samples to recover the posterior and compute the evidence $\mathcal {Z}$. Source: \blx@tocontentsinit {0}\cite {MCMC_vs_NS}.}}{64}{figure.2.15}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Illustration of the Metropolis-Hastings random walk in parameter space. Starting from initial samples drawn from the prior $\pi (\boldsymbol {\theta })$, walkers explore the parameter space following the acceptance criterion \eqref {eq:MH}, progressively converging toward the high-probability region of the posterior $p(\boldsymbol {\theta }|y)$. Source: \blx@tocontentsinit {0}\cite {image_MCMC}.}}{65}{figure.2.16}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Geometric interpretation of nested sampling. \textit {Left:} iso-likelihood contours in parameter space, with the discarded live points $\mathcal {L}_1 > \mathcal {L}_2 > \mathcal {L}_3 > \mathcal {L}_4$ marking successive likelihood shells. \textit {Right:} the corresponding one-dimensional mapping $\mathcal {L}(X)$ as a function of the enclosed prior volume $X$, where the evidence $\mathcal {Z}$ is approximated as the area under the curve via the trapezoid rule. Source: \blx@tocontentsinit {0}\cite {nestedsampling}.}}{66}{figure.2.17}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Schematic representation of GW lensing. A galaxy acting as a macrolens can produce multiple images of the same GW signal, arriving at the detector with different magnifications and time delays. Compact objects embedded within the lens galaxy (microlenses) can further perturb these images, introducing additional amplification, interference, and diffraction effects. The images shown at the bottom illustrate examples of strong gravitational lensing observed in electromagnetic astronomy. Original illustration based on sources: \blx@tocontentsinit {0}\cite {LIGO_lensing_image, Figure_micro_strong_lensing}.}}{68}{figure.3.1}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Illustration of the lens-mass scales relevant for gravitationally lensed signals. Depending on the relation between the radiation wavelength and the characteristic scale of the lensing potential, lensing occurs in either the geometric optics or wave optics regime. While geometric optics describes distinct propagation paths, wave optics accounts for diffraction and interference effects. Due to their long wavelengths, GW can exhibit wave-optics effects for relatively low lens masses. Source: \blx@tocontentsinit {0}\cite {multi_messenger_gravitational_lensing}.}}{69}{figure.3.2}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Geometry of gravitational lensing in the thin lens approximation. The observer (O), lens (L), and source (S) define the angular diameter distances $D_L$, $D_S$, and $D_{LS}$. The true source position $\boldsymbol {\beta }$ and the apparent image position $\boldsymbol {\theta }$ are related by the lens equation through the reduced deflection angle $\boldsymbol {\alpha }$. Adapted from the source: \blx@tocontentsinit {0}\cite {Sachs2008LensingAngles}.}}{71}{figure.3.3}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Wavefront picture of gravitational lensing. Left: light rays from a distant source are deflected near the centre, where the gravitational field is strongest. Centre: the corresponding wavefronts at a fixed time. The small closed loop arises from rays undergoing very large deflections. Right: a second wavefront traced backwards from the observer (dashed) is superimposed on the frozen source wavefront (solid). Lensed images form where the two wavefronts share the same local direction of propagation, which corresponds to the stationary points of the Fermat potential \eqref {eq:fermat_potential}. Source: \blx@tocontentsinit {0}\cite {essentialsstronggravitationallensing}.}}{72}{figure.3.4}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces \textit {Left:} modulus of the dimensionless amplification factor $|F(w)|$ as a function of dimensionless frequency $w = 8\pi GM_{Lz}f$ for a SIS lens with impact parameter $y = 0.7$. Three regimes are distinguished: perturbative (low $w$, negligible lensing), wave optics (intermediate $w$, diffraction and interference), and geometric optics (high $w$, $|F|$ converges to the sum of image magnifications). \textit {Right:} time-domain waveforms of a $30+30\,M_\odot $ BBH system (unlensed in black, lensed in colour) for three effective lens masses representative of each regime (panels a, b, c). In the geometric optics limit (panel c), the two images are clearly separated in time by $\Delta t_{12}$ and have distinct amplitudes $\sqrt {|\mu _1|}$ and $\sqrt {|\mu _2|}$. Source: \blx@tocontentsinit {0}\cite {amplificationfactor_figure}.}}{77}{figure.3.5}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Contour maps of the Fermat potential $\tau (\boldsymbol {\theta })$ for three different source positions with the same lens potential, shown qualitatively in the image plane $\boldsymbol {\theta }$. Type I images (minima) are marked in blue, Type II (saddle points) in red, and Type III (maxima) in green. The thick black contours pass through the saddle points. The figure is intended to illustrate the topological structure of the arrival-time surface rather than a specific lens model or parameter space. Source: \blx@tocontentsinit {0}\cite {essentialsstronggravitationallensing}.}}{77}{figure.3.6}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Distribution of network SNR $\rho _\mathrm {net}$ for the 157 injected lensed BBH events after the duty cycle filter. The distribution is truncated at $\rho _\mathrm {net} = 10$ by construction and peaks just above the threshold, with a tail extending to higher values for strongly magnified or favorably oriented systems.}}{85}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Distribution of the primary source-frame mass $m_1$ for the 157 injected lensed BBH events. The shape reflects the LIGO O3 Power Law + Gaussian population model adopted by \texttt {LER} v0.4.2, with a dominant low-mass component and a secondary feature near $30\,M_\odot $ from the Gaussian component.}}{86}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Source-frame component masses $m_1^{\mathrm {src}}$ and $m_2^{\mathrm {src}}$ for the 500 detectable lensed BBH events selected by \textsc {LeR}, colour-coded by network SNR $\rho _\mathrm {net}$. Diagonal dashed lines mark constant total mass $M$ and dotted lines mark constant mass ratio $q$. The population traces the underlying LIGO O3 Power Law + Gaussian model (\S \ref {sec:LER_population}), with most events clustering near $q=1$ and the highest-SNR events concentrated around $M\sim 50$--$70\,M_\odot $.}}{87}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Distribution of image magnifications $\mu $ for the lensed population prior to the duty cycle filter. Negative values correspond to Type II images (saddle points of the Fermat potential), which have mirror-inverted parity and acquire a $\pi /2$ Morse phase shift (see \S \ref {sec:strong_lensing}). The distribution is strongly peaked near $|\mu | \sim 1$ with extended tails at large $|\mu |$, consistent with the SIS power-law magnification prior adopted by \texttt {LER}.}}{88}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Distribution of time delays $\Delta t$ between the two lensed images for the 157 injected events, shown on a logarithmic scale. The distribution spans from minutes to months, consistent with galaxy-scale lenses in the geometric optics regime. The Earth's rotation during this interval is the primary mechanism enabling improved sky localization through joint analysis (\S \ref {sec:joint_PE_skyloc}).}}{88}{figure.4.5}%
